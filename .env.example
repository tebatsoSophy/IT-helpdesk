# Copy to .env (docker compose reads it automatically). Never commit the real file.

# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_EXPIRATION=86400000

# First administrator, created on first start if no admin exists.
ADMIN_EMAIL=admin@helpdesk.local
ADMIN_PASSWORD=Admin123!

# Demo technicians, a demo user and sample tickets. Set to false for real use.
SEED_DEMO_DATA=true

# Enable only while developing: exposes the H2 web console at /h2-console.
H2_CONSOLE_ENABLED=false

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
